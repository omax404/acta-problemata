% ---------- drawing parts ----------
\newcommand{\mono}[1]{{\monofont\color{ink}#1}}
\newcommand{\actadotgrid}[2]{\foreach \i in {0,...,4}{\foreach \j in {0,...,4}{\fill[orange] (#1+4*\i,#2+4*\j) circle (0.7);}}}
\newcommand{\actabars}[3]{\foreach \o in {0,1.2,2.4,3.6}{\draw[ink,line width=.35pt] (#1,#2-\o)--++(#3,0);}\draw[ink,line width=.35pt](#1-1.8,#2)--++(0,-3.6);}
\newcommand{\actamark}[2]{\draw[ink,line width=.3pt](#1-2,#2)--++(4,0)(#1,#2-2)--++(0,4);}
\newcommand{\actaspeck}[5]{\fill[orange](#1,#2)rectangle++(#3,#4);\pgfmathsetseed{#5}%
 \foreach \k in {1,...,170}{\pgfmathsetmacro{\px}{#1+rnd*#3}\pgfmathsetmacro{\py}{#2+rnd*#4}\fill[paper!70!orange](\px,\py)circle(.2);}}
\newcommand{\actafinger}[3]{\pgfmathsetseed{#3}%
 \foreach \i in {0,...,31}{\foreach \j in {0,...,6}{%
  \pgfmathtruncatemacro{\on}{(rnd<(0.04+0.96*pow((\i+1)/32,1.5)))?1:0}%
  \ifnum\on=1\fill[ink](#1+1.3*\i,#2+1.3*\j)circle(0.42);\fi}}}
\newcommand{\actagrain}{\pgfmathsetseed{11}\foreach \k in {1,...,330}{\pgfmathsetmacro{\px}{210*rnd}\pgfmathsetmacro{\py}{297*rnd}\fill[paper!90!ink](\px,\py)circle(.22);}}
\newcommand{\actaqr}[3]{\node[fill=paper!35!white,inner sep=1.6mm,draw=orange,line width=.5pt] at (#1,#2){\qrcode[height=#3,level=M]{\actaqrurl}};}
